+/// Explicit compatibility mode for the Linux Podman engine inside an Apple VM.
+/// Docker remains the default; no failed request switches engine or policy.
+pub(super) fn podman() -> bool {
+    std::env::var("LAYERFS_ENGINE").as_deref() == Ok("podman")
+}
+
+/// Podman takes a profile filename and returns canonical option spellings.
+/// The file contains exactly the same frozen syscall policy as SECCOMP.
+pub(super) fn security_options() -> [&'static str; 3] {
+    if podman() {
+        [
+            "no-new-privileges",
+            "seccomp=/opt/layerfs/apple/seccomp.json",
+            "apparmor=unconfined",
+        ]
+    } else {
+        ["no-new-privileges=true", "apparmor=unconfined", SECCOMP]
+    }
+}
