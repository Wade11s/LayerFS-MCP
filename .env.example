LAYERFS_MCP_PROJECT=default
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
LAYERFS_MCP_TOKEN=replace-with-a-random-token
# After docker build -t layerfs-mcp:local . : docker image inspect layerfs-mcp:local --format '{{.Id}}'
LAYERFS_IMAGE=sha256:replace-with-the-64-hex-local-image-id
LAYERFS_SOURCE_DIR=./examples/seed
